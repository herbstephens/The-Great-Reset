{
  "name": "@democracy-earth/time-protocol",
  "version": "1.0.0",
  "description": "TIME Protocol - A Global Human Time Ledger",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:worldchain-sepolia": "hardhat run scripts/deploy.js --network worldchain-sepolia",
    "deploy:worldchain": "hardhat run scripts/deploy.js --network worldchain",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network base-sepolia",
    "deploy:base": "hardhat run scripts/deploy.js --network base",
    "verify": "hardhat verify",
    "clean": "hardhat clean",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.js' 'scripts/**/*.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/democracy-earth/time-protocol.git"
  },
  "keywords": [
    "ethereum",
    "solidity",
    "time",
    "protocol",
    "blockchain",
    "world-id",
    "democracy-earth"
  ],
  "author": "Democracy Earth Foundation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/democracy-earth/time-protocol/issues"
  },
  "homepage": "https://democracy.earth",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.6",
    "chai": "^4.5.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.10",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.0.0",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@layerzerolabs/lz-evm-oapp-v2": "^2.0.0"
  }
}
